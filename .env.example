# Copie para .env e troque a senha. Senha só com letras, números e _ (evita escapar na URL e no shell).
PORT=3030

# Porta 5000 = HAProxy -> sempre o primário do Patroni (hoje pg2). Os 3 endereços servem para tolerar um nó fora.
# Dentro da rede interna das VMs também dá para usar 192.168.15.250:5000
PG_HOSTS=192.168.88.28:5000,192.168.88.29:5000,192.168.88.31:5000

PG_USER=cyberfinance_app
PG_PASSWORD="TROQUE_AQUI"
PG_DATABASE=cyberfinance
PG_SSLMODE=disable
PG_POOL_MAX=15

# Opcional: exige "Authorization: Bearer <token>" em /api/state e /api/sync (na tela: aba PostgreSQL -> Chave de Autenticação)
# API_TOKEN=
